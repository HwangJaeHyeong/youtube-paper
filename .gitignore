# Secrets
.env
.env.local
*.key
credentials.json
token.json
client_secret*.json
credentials/

# Claude Code personal settings (team settings stay in .claude/settings.json)
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Data artifacts (large / regenerable) — everything under data/ is ignored
# except .gitkeep markers that preserve the directory structure on fresh clones.
data/*
!data/papers/
!data/scripts/
!data/audio/
!data/videos/
data/papers/*
data/scripts/*
data/audio/*
data/videos/*
!data/**/.gitkeep

# Local experiment / debug artifacts that sometimes land at data/ root
data/check_*.png
data/run_logs/

# Media output
*.mp3
*.mp4
*.wav
*.m4a
*.webm
*.srt

# Small, intentional reference audio for reproducible HaptiCraft builds.
!recipes/hapticraft/reference/narration-1.2x.wav

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Project-local third-party binaries (poppler etc.)
tools/

# Docker inbox: PDFs in / videos out
input/*.pdf
input/finished/*
!input/finished/.gitkeep
output/*
!output/.gitkeep
# Frozen inputs for portable paper recipes.
!recipes/*/reference/narration-1.2x.wav
!recipes/*/reference/intro-demo.mp4
