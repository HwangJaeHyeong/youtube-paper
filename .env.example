# Script generation: claude (default) | codex
LLM_PROVIDER=claude
# Claude: leave empty to use Claude Code login, or set an API key for API billing.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_POLISH_MODEL=claude-opus-4-7
# Codex: install Codex CLI and run `codex login` first.
# Empty model uses the CLI's configured default; polish inherits CODEX_MODEL.
CODEX_MODEL=
CODEX_POLISH_MODEL=
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=600

# Google AI Studio (Gemini - fallback TTS)
GOOGLE_API_KEY=AIza...

# Naver Cloud Platform CLOVA Voice Premium (main TTS)
# https://www.ncloud.com/product/aiService/clovaVoice
NCP_CLOVA_KEY_ID=
NCP_CLOVA_KEY=

# YouTube Data API v3 (Phase 4 에서 사용)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRET_FILE=credentials/youtube_oauth_client.json

# Optional: 백업 TTS 공급자
ELEVENLABS_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# Runtime
LOG_LEVEL=INFO
DATA_DIR=./data
